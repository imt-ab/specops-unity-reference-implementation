{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "bootstrap-provenance.schema.json",
  "title": "SpecOps Bootstrap Provenance",
  "description": "Deterministic derived construction lineage for a Bootstrap v1 child. It is non-authoritative, non-release-evidence, and records no validation, release, publication, or Human Authority claim.",
  "x-contract-version": "1.0.0",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contractVersion",
    "classification",
    "authorityStatus",
    "evidenceStatus",
    "sourceBaseline",
    "bootstrap",
    "contentInputs"
  ],
  "properties": {
    "contractVersion": {
      "const": "1.0.0"
    },
    "classification": {
      "const": "DERIVED_BOOTSTRAP_PROVENANCE"
    },
    "authorityStatus": {
      "const": "NON_AUTHORITATIVE"
    },
    "evidenceStatus": {
      "const": "NON_RELEASE_EVIDENCE"
    },
    "sourceBaseline": {
      "$ref": "#/$defs/sourceBaseline"
    },
    "bootstrap": {
      "$ref": "#/$defs/bootstrap"
    },
    "contentInputs": {
      "$ref": "#/$defs/contentInputs"
    }
  },
  "$defs": {
    "semVer": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(?:-[0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*)?(?:\\+[0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*)?$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "sourceBaseline": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "version",
        "sourceIdentity"
      ],
      "properties": {
        "id": {
          "const": "specops-unity-clean-architecture-golden-baseline"
        },
        "version": {
          "const": "2.0.0"
        },
        "sourceIdentity": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "profile",
            "digest"
          ],
          "properties": {
            "profile": {
              "const": "specops-bootstrap-source-jcs-sha256-v1"
            },
            "digest": {
              "$ref": "#/$defs/sha256"
            }
          }
        }
      }
    },
    "bootstrap": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "contractVersion",
        "implementationVersion"
      ],
      "properties": {
        "contractVersion": {
          "const": "1.0.0"
        },
        "implementationVersion": {
          "$ref": "#/$defs/semVer"
        }
      }
    },
    "contentInputs": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "ProjectId",
        "ProductName",
        "CompanyName",
        "ApplicationIdentifier",
        "CodeNamespaceRoot"
      ],
      "properties": {
        "ProjectId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 63,
          "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$"
        },
        "ProductName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "CompanyName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "ApplicationIdentifier": {
          "type": "string",
          "minLength": 5,
          "maxLength": 255,
          "pattern": "^[a-z][a-z0-9]*(?:\\.[a-z][a-z0-9]*){2,}$"
        },
        "CodeNamespaceRoot": {
          "type": "string",
          "minLength": 1,
          "maxLength": 255,
          "pattern": "^[A-Z][A-Za-z0-9]*(?:\\.[A-Z][A-Za-z0-9]*)*$"
        }
      }
    }
  }
}
