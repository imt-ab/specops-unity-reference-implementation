    {
      "id": "full-duplicate-member-rejected",
      "classes": [
        "H"
      ],
      "mode": "FULL_JSON",
      "purpose": "Duplicate object member names must be detected before lossy parsing.",
      "inputJsonText": "{\"a\":1,\"a\":2}",
      "expectedOutcome": "REJECT",
      "rejectionClass": "DUPLICATE_OBJECT_MEMBER_NAME",
      "normativeReason": "RFC 8785 requires I-JSON input without duplicate object property names; this profile requires detection before lossy object-model conversion."
    },
    {
      "id": "rfc8785-canonical-sample",
      "classes": [
        "I",
        "J"
      ],
      "mode": "FULL_JSON",
      "purpose": "RFC 8785 Sections 3.2.2 through 3.2.4 known answer for Unicode escaping, property ordering, number serialization, and UTF-8 output.",
