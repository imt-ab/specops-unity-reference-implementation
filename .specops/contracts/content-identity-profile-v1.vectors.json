      "expectedCanonicalJson": "{\"literals\":[null,true,false],\"numbers\":[333333333.3333333,1e+30,4.5,0.002,1e-27],\"string\":\"€$\\u000f\\nA'B\\\"\\\\\\\\\\\"/\"}",
      "expectedSha256Hex": "2d5e01a318d0f0879ab568c4be289c8b1f64ef8921a53c6277d5e069978baacb",
      "normativeBasis": "RFC 8785 Sections 3.2.2, 3.2.3, and 3.2.4."
    },
    {
