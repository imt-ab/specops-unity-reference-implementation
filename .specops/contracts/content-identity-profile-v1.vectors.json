    {
      "id": "full-object-canonical",
      "classes": [
        "A",
        "B"
      ],
      "mode": "FULL_JSON",
      "purpose": "Baseline for whitespace and object-property-order invariance.",
      "inputJsonText": "{\"a\":1,\"b\":2}",
      "expectedOutcome": "IDENTITY",
      "expectedCanonicalJson": "{\"a\":1,\"b\":2}",
      "expectedSha256Hex": "43258cff783fe7036d8a43033f830adfc60ec037382473548ac742b888292777"
    },
    {
      "id": "full-whitespace-expanded",
      "classes": [
        "A"
      ],
      "mode": "FULL_JSON",
      "purpose": "Different insignificant whitespace must preserve the baseline identity.",
      "inputJsonText": "{\n  \"a\" : 1,\n  \"b\" : 2\n}",
      "expectedOutcome": "IDENTITY",
      "expectedCanonicalJson": "{\"a\":1,\"b\":2}",
      "expectedSha256Hex": "43258cff783fe7036d8a43033f830adfc60ec037382473548ac742b888292777"
    },
