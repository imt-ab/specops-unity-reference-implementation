    },
    {
      "id": "full-unicode-decomposed",
      "classes": [
        "I"
      ],
      "mode": "FULL_JSON",
      "purpose": "Decomposed half of a pair that detects an implementation incorrectly applying NFC, NFD, or another Unicode normalization.",
      "inputJsonText": "{\"value\":\"e\\u0301\"}",
      "expectedOutcome": "IDENTITY",
      "expectedCanonicalJson": "{\"value\":\"e\u0301\"}",
