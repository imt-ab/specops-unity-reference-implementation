    },
    {
      "id": "full-leading-utf8-bom-rejected",
      "classes": [
        "I"
      ],
      "mode": "FULL_JSON",
      "purpose": "Source JSON whose UTF-8 encoding begins EF BB BF must be rejected rather than silently stripping or ignoring the leading BOM.",
      "inputJsonText": "\uFEFF{\"a\":1}",
      "expectedOutcome": "REJECT",
      "rejectionClass": "LEADING_UTF8_BOM",
      "normativeReason": "SpecOps profile-specific deterministic input rule: a leading U+FEFF encoded as the UTF-8 BOM bytes EF BB BF is rejected and produces no identity."
    },
    {
      "id": "full-lone-surrogate-rejected",
      "classes": [
        "I"
      ],
      "mode": "FULL_JSON",
      "purpose": "Invalid Unicode data must fail closed rather than be normalized or replaced.",
      "inputJsonText": "{\"value\":\"\\ud800\"}",
      "expectedOutcome": "REJECT",
      "rejectionClass": "INVALID_UNICODE_DATA",
      "normativeReason": "RFC 8785 requires a compliant implementation to terminate on invalid Unicode data such as a lone surrogate."
    }
  ]
