      "expectedCanonicalJson": "{\"\\r\":\"Carriage Return\",\"1\":\"One\",\"\u0080\":\"Control\",\"ö\":\"Latin Small Letter O With Diaeresis\",\"€\":\"Euro Sign\",\"😀\":\"Emoji: Grinning Face\",\"\uFB33\":\"Hebrew Letter Dalet With Dagesh\"}",
      "expectedSha256Hex": "5e321556d22018a9656991a9e94f77ec175fa193e52a2429d312f8419ec8b08c",
      "normativeBasis": "RFC 8785 Section 3.2.3 property-sorting test data and expected order, together with Section 3.2.2 string serialization."
    },
    {
