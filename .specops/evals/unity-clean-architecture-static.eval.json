{
  "contractVersion": "1.0.0",
  "definitionId": "unity-clean-architecture-static",
  "definitionVersion": "1.0.0",
  "contentIdentity": {
    "algorithm": "specops-json-jcs-sha256-v1",
    "value": "aa07fa7eb27c04755372b981fb330646d1f3b9378f422336c24080368d87d64f"
  },
  "description": "Derived deterministic static definition for the Unity Clean Architecture boundaries declared by ARCHITECTURE.md; it is not structural authority.",
  "targetScope": [
    {
      "type": "unity-project-runtime-architecture",
      "id": "infinite-monkey-runtime-layers",
      "reference": "Assets/Project/Code/Runtime"
    }
  ],
  "governingReferences": [
    {
      "type": "structural-authority",
      "id": "clean-architecture",
      "reference": "Assets/Project/Docs/Architecture/ARCHITECTURE.md"
    },
    {
      "type": "repository-constraint-authority",
      "id": "global-constraints",
      "reference": "Assets/Project/Docs/Governance/GLOBAL_CONSTRAINTS.md"
    },
    {
      "type": "derived-contract",
      "id": "eval-definition.schema.json",
      "version": "1.0.0",
      "reference": ".specops/contracts/eval-definition.schema.json"
    },
    {
      "type": "normative-calculation-profile",
      "id": "specops-json-jcs-sha256-v1",
      "version": "1",
      "reference": ".specops/contracts/content-identity-profile-v1.md"
    }
  ],
  "checks": [
    {
      "id": "runtime-asmdef-set",
      "description": "The authoritative seven runtime asmdef paths exist exactly once and no additional runtime asmdef is present.",
      "evaluationMethod": "exact-set-comparison",
      "passCondition": {
        "type": "exact-set",
        "value": {
          "inventory": {
            "root": "Assets/Project/Code/Runtime",
            "include": [
              "**/*.asmdef"
            ],
            "exclude": [],
            "order": "repository-relative-ordinal"
          },
          "expected": [
            "Assets/Project/Code/Runtime/AI/InfiniteMonkey.AI.asmdef",
            "Assets/Project/Code/Runtime/Application/InfiniteMonkey.Application.asmdef",
            "Assets/Project/Code/Runtime/Composition/InfiniteMonkey.Composition.asmdef",
            "Assets/Project/Code/Runtime/Domain/InfiniteMonkey.Domain.asmdef",
            "Assets/Project/Code/Runtime/Infrastructure/InfiniteMonkey.Infrastructure.asmdef",
            "Assets/Project/Code/Runtime/Presentation/InfiniteMonkey.Presentation.asmdef",
            "Assets/Project/Code/Runtime/Utility/InfiniteMonkey.Utility.asmdef"
          ],
          "comparison": "repository-relative-path-ordinal",
          "duplicates": "reject"
        }
      }
    },
    {
      "id": "runtime-assembly-names",
      "description": "Each authoritative runtime asmdef declares its exact authority-defined assembly name.",
      "evaluationMethod": "static-json-inspection",
      "passCondition": {
        "type": "all-items-conform",
        "value": {
          "inventoryReference": "runtime-asmdef-set",
          "jsonPointer": "/name",
          "expectedByPath": {
            "Assets/Project/Code/Runtime/AI/InfiniteMonkey.AI.asmdef": "InfiniteMonkey.AI",
            "Assets/Project/Code/Runtime/Application/InfiniteMonkey.Application.asmdef": "InfiniteMonkey.Application",
            "Assets/Project/Code/Runtime/Composition/InfiniteMonkey.Composition.asmdef": "InfiniteMonkey.Composition",
            "Assets/Project/Code/Runtime/Domain/InfiniteMonkey.Domain.asmdef": "InfiniteMonkey.Domain",
            "Assets/Project/Code/Runtime/Infrastructure/InfiniteMonkey.Infrastructure.asmdef": "InfiniteMonkey.Infrastructure",
            "Assets/Project/Code/Runtime/Presentation/InfiniteMonkey.Presentation.asmdef": "InfiniteMonkey.Presentation",
            "Assets/Project/Code/Runtime/Utility/InfiniteMonkey.Utility.asmdef": "InfiniteMonkey.Utility"
          },
          "equality": "ordinal-string"
        }
      }
    },
    {
      "id": "engine-independence-flags",
      "description": "Domain and Application explicitly declare noEngineReferences=true.",
      "evaluationMethod": "static-json-inspection",
      "passCondition": {
        "type": "equals",
        "value": {
          "subjects": [
            "Assets/Project/Code/Runtime/Domain/InfiniteMonkey.Domain.asmdef",
            "Assets/Project/Code/Runtime/Application/InfiniteMonkey.Application.asmdef"
          ],
          "jsonPointer": "/noEngineReferences",
          "expected": true,
          "comparison": "json-boolean-exact"
        }
      }
    },
    {
      "id": "runtime-project-reference-graph",
      "description": "Every semantic project-assembly reference is within the architecture-defined allowlist; GUID and name references are resolved before comparison.",
      "evaluationMethod": "static-json-inspection",
      "passCondition": {
        "type": "subset-of-allowlist",
        "value": {
          "inventoryReference": "runtime-asmdef-set",
          "referenceJsonPointer": "/references",
          "semanticResolution": {
            "exactAssemblyName": true,
            "guidPrefix": "GUID:",
            "projectAsmdefRoots": [
              "Assets"
            ],
            "guidSource": "adjacent-asmdef-meta",
            "comparison": "ordinal-assembly-name",
            "externalNonProjectReferencesExcluded": true,
            "unresolvedProjectReference": "reject"
          },
          "allowedTargetsByAssembly": {
            "InfiniteMonkey.Domain": [],
            "InfiniteMonkey.Application": [
              "InfiniteMonkey.Domain",
              "InfiniteMonkey.Utility"
            ],
            "InfiniteMonkey.AI": [
              "InfiniteMonkey.Application",
              "InfiniteMonkey.Domain",
              "InfiniteMonkey.Utility"
            ],
            "InfiniteMonkey.Infrastructure": [
              "InfiniteMonkey.Application",
              "InfiniteMonkey.Domain",
              "InfiniteMonkey.Utility"
            ],
            "InfiniteMonkey.Presentation": [
              "InfiniteMonkey.Application",
              "InfiniteMonkey.Utility"
            ],
            "InfiniteMonkey.Composition": [
              "InfiniteMonkey.Application",
              "InfiniteMonkey.Domain",
              "InfiniteMonkey.Infrastructure",
              "InfiniteMonkey.Presentation",
              "InfiniteMonkey.Utility"
            ],
            "InfiniteMonkey.Utility": []
          },
          "unusedAllowedTargetsRequired": false,
          "diagnosticOrder": "ordinal-assembly-name"
        }
      }
    },
    {
      "id": "domain-application-source-boundary",
      "description": "A bounded lexical scan excludes Unity namespaces and MonoBehaviour inheritance from Domain and Application source while ignoring comments and literal contents.",
      "evaluationMethod": "static-source-boundary",
      "passCondition": {
        "type": "all-items-conform",
        "value": {
          "roots": [
            "Assets/Project/Code/Runtime/Domain",
            "Assets/Project/Code/Runtime/Application"
          ],
          "include": [
            "**/*.cs"
          ],
          "analysisModel": "csharp-lexical-tokens-v1",
          "excludedLexicalRegions": [
            "comments",
            "string-literals",
            "character-literals"
          ],
          "prohibitedUsingNamespacePrefixes": [
            "UnityEngine",
            "UnityEditor"
          ],
          "prohibitedQualifiedIdentifierPrefixes": [
            "UnityEngine.",
            "UnityEditor."
          ],
          "prohibitedBaseTypeIdentifiers": [
            "MonoBehaviour",
            "UnityEngine.MonoBehaviour"
          ],
          "comparison": "ordinal-token",
          "limitation": "Lexical token inspection is not full C# semantic or compiled-reference analysis."
        }
      }
    },
    {
      "id": "generated-artifacts-untracked",
      "description": "Generated Unity, IDE, build, and diagnostic paths prohibited by repository rules are absent from the tracked subject inventory.",
      "evaluationMethod": "static-repository-inspection",
      "passCondition": {
        "type": "tracked-paths-absent",
        "value": {
          "inventory": "tracked-subject-paths",
          "patternsSource": ".gitignore",
          "prohibitedPatterns": [
            "[Ll]ibrary/",
            "[Tt]emp/",
            "[Oo]bj/",
            "[Bb]uild/",
            "[Bb]uilds/",
            "[Ll]ogs/",
            "UserSettings/",
            "MemoryCaptures/",
            "Recordings/",
            ".plastic/",
            ".vs/",
            ".idea/",
            ".vscode/",
            ".fleet/",
            "ExportedObj/",
            ".consulo/",
            "*.csproj",
            "*.unityproj",
            "*.sln",
            "*.suo",
            "*.tmp",
            "*.user",
            "*.userprefs",
            "*.pidb",
            "*.booproj",
            "*.svd",
            "*.pdb",
            "*.mdb",
            "*.opendb",
            "*.VC.db",
            ".DS_Store",
            "Thumbs.db",
            "desktop.ini",
            "*.apk",
            "*.aab",
            "sysinfo.txt"
          ],
          "pathSemantics": "repository-relative-forward-slash",
          "ignoredLocalPresenceIsNotFailure": true
        }
      }
    }
  ]
