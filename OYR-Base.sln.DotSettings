  <s:String x:Key="/Default/PatternsAndTemplates/LiveTemplates/Template/=ADF82853687DF10891AFD20CB21783BA/Text/@EntryValue">using System.Collections;
using Moq;
using NUnit.Framework;
using UnityEngine;
using UnityEngine.TestTools;
using VContainer;

/// &lt;summary&gt;
/// PlayMode integration tests for $CLASS$.
/// Follows AI_RULES testing constraints (Moq + VContainer, no reflection, cleanup).
/// &lt;/summary&gt;
public class $CLASS$PlayModeTests
{
    private GameObject _root;
    private IObjectResolver _container;

    [SetUp]
    public void SetUp()
    {
        _root = new GameObject("$CLASS$TestRoot");
        var builder = new ContainerBuilder();
        // TODO: Register dependencies
        _container = builder.Build();
    }

    [TearDown]
    public void TearDown()
    {
        if (_root != null)
        {
            Object.DestroyImmediate(_root);
        }
        _container?.Dispose();
    }

    /// &lt;summary&gt;
    /// Should behave correctly over frames when ...
    /// &lt;/summary&gt;
    [UnityTest]
    public IEnumerator $METHOD$_Should_DoExpectedBehavior_OverFrames()
    {
        // Arrange

        // Act
        yield return null; // allow a frame

        // Assert
        Assert.Pass();
    }
}
$END$</s:String>
