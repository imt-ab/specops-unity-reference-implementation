  <s:String x:Key="/Default/PatternsAndTemplates/LiveTemplates/Template/=18661CE93E5E9E43DEACCC3A31658D36/Text/@EntryValue">using System;
using Moq;
using NUnit.Framework;
using VContainer;

/// &lt;summary&gt;
/// EditMode tests for $CLASS$.
/// Follows AI_RULES testing constraints (Moq + VContainer, no reflection).
/// &lt;/summary&gt;
public class $CLASS$Tests
{
    [Test]
    public void $METHOD$_Should_DoExpectedBehavior()
    {
        var builder = new ContainerBuilder();
        var mock = new Mock&lt;$DEPENDENCY$&gt;();
        builder.RegisterInstance(mock.Object);
        builder.Register&lt;$CLASS$&gt;(Lifetime.Singleton);

        using var container = builder.Build();
        var service = container.Resolve&lt;$CLASS$&gt;();

        // Arrange

        // Act

        // Assert
        Assert.Pass();
    }
}
$END$</s:String>
