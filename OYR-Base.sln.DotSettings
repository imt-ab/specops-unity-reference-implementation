  <s:String x:Key="/Default/PatternsAndTemplates/LiveTemplates/Template/=65D34A6A6657B669AF30E69B327045A0/Text/@EntryValue">// Create mock
var mock = new Mock&lt;$INTERFACE$&gt;();

// Setup behavior
mock.Setup(x =&gt; x.$METHOD$).Returns($RETURN$);

// Register to builder
builder.RegisterInstance(mock.Object).As&lt;$INTERFACE$&gt;();
