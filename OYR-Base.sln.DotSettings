  <s:String x:Key="/Default/PatternsAndTemplates/LiveTemplates/Template/=F5F828E3A570D243050386B890C1D3FA/Text/@EntryValue">using NUnit.Framework;
using UnityEngine;

/// &lt;summary&gt;
/// EditMode tests for $COMPONENT$ MonoBehaviour.
/// &lt;/summary&gt;
public class $COMPONENT$Tests
{
    private GameObject _gameObject;
    private $COMPONENT$ _component;

    [SetUp]
    public void SetUp()
    {
        _gameObject = new GameObject("$COMPONENT$TestObject");
        _component = _gameObject.AddComponent&lt;$COMPONENT$&gt;();
    }

    [TearDown]
    public void TearDown()
    {
        if (_gameObject != null)
        {
            Object.DestroyImmediate(_gameObject);
        }
    }

    /// &lt;summary&gt;
    /// Should behave correctly when ...
    /// &lt;/summary&gt;
    [Test]
    public void Should_DoExpectedBehavior()
    {
        // Arrange

        // Act

        // Assert
        Assert.Pass();
    }
}
$END$</s:String>
